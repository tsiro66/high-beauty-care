---
import bgImage from "../assets/bg-image.jpg";

type Locale = "en" | "el";
const locale = (Astro.currentLocale ?? "en") as Locale;

const strings = {
  en: {
    eyebrow: "Aesthetics & Wellness Studio",
    heading: "Beauty begins with care.",
    sub: "Personalized facial and body treatments in a calm, considered space — designed around you.",
    primaryCta: "Book an appointment",
    secondaryCta: "Gift a coupon",
  },
  el: {
    eyebrow: "Στούντιο Αισθητικής & Ευεξίας",
    heading: "Η ομορφιά ξεκινά από την περιποίηση.",
    sub: "Εξατομικευμένες θεραπείες προσώπου και σώματος σε έναν ήρεμο, προσεγμένο χώρο — σχεδιασμένες γύρω από εσάς.",
    primaryCta: "Κλείστε ραντεβού",
    secondaryCta: "Χαρίστε δωροκάρτα",
  },
} as const;

const t = strings[locale];
---

<section class="relative flex min-h-screen items-end overflow-hidden">
  <img
    src={bgImage.src}
    alt=""
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Scrims: keep text legible without killing the airy feel -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-r from-zinc-50/85 via-zinc-50/35 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t from-zinc-50/90 via-zinc-50/20 to-transparent md:from-zinc-50/40"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-24 pt-40 md:px-10 md:pb-32"
  >
    <p
      class="flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.35em] text-zinc-900"
    >
      <span aria-hidden="true" class="h-px w-12 bg-zinc-900"></span>
      {t.eyebrow}
    </p>

    <h1
      class="mt-6 max-w-3xl font-display text-5xl leading-[1.02] tracking-tight text-zinc-900 sm:text-6xl md:text-8xl"
    >
      {t.heading}
    </h1>

    <p class="mt-6 max-w-md text-base leading-relaxed text-zinc-600 md:text-lg">
      {t.sub}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="inline-block bg-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-50 transition-colors hover:bg-zinc-700"
      >
        {t.primaryCta}
      </a>
      <a
        href="#gift"
        class="inline-block border border-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-900 transition-colors hover:bg-zinc-900 hover:text-zinc-50"
      >
        {t.secondaryCta}
      </a>
    </div>
  </div>
</section>
