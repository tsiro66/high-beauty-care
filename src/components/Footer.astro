---
import { ui } from "../data/ui";
import { contact } from "../data/contact";
import { getCategories, type Locale } from "../data/site";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = ui[locale];
const homeUrl = getRelativeLocaleUrl(locale, "/");
const categories = getCategories(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400">
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-6 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:gap-16 md:px-10 md:py-20"
  >
    <div>
      <p class="font-display text-xl uppercase tracking-[0.25em] text-zinc-50 md:text-2xl">
        High Beauty Care
      </p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-zinc-400">{t.footer.tagline}</p>
    </div>

    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-zinc-500">
        {t.footer.services}
      </p>
      <ul class="mt-5 space-y-2.5 text-sm">
        {
          categories.map((category) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `/services/${category.slug}/`)}
                class="transition-colors hover:text-zinc-100"
              >
                {category.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-zinc-500">
        {t.nav.contact}
      </p>
      <ul class="mt-5 space-y-2.5 text-sm">
        <li>
          <a href={contact.phoneHref} class="transition-colors hover:text-zinc-100">
            {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a
            href={`mailto:${contact.email}`}
            class="transition-colors hover:text-zinc-100"
          >
            {contact.email}
          </a>
        </li>
        <li>{contact.street}, {contact.city}</li>
        <li>
          <a
            href={contact.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-zinc-100"
          >
            {contact.instagramHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Map -->
  <div class="border-t border-zinc-800">
    <div class="mx-auto w-full max-w-7xl px-6 pt-12 md:px-10">
      <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-zinc-500">
        {t.footer.findUs}
      </p>
    </div>
    <div class="mt-6 h-64 w-full border-y border-zinc-800 md:h-80">
      <iframe
        src={contact.mapsEmbedUrl}
        title={`${contact.street}, ${contact.city} — Google Maps`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        class="h-full w-full grayscale contrast-[1.05] opacity-90 transition-all duration-500 hover:opacity-100 hover:grayscale-0"
      ></iframe>
    </div>
  </div>

  <div class="border-t border-zinc-800">
    <div
      class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-2 px-6 py-6 text-[11px] uppercase tracking-[0.25em] text-zinc-500 md:px-10"
    >
      <p>© {year} High Beauty Care — {t.footer.rights}</p>
      <a href={homeUrl} class="transition-colors hover:text-zinc-50">
        High Beauty Care
      </a>
    </div>
  </div>
</footer>
