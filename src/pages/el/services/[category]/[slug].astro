---
import Base from "../../../../layouts/Base.astro";
import { contact } from "../../../../data/contact";
import { getCategories, getTreatmentNeighbours, locales, type Locale } from "../../../../data/site";
import { ui } from "../../../../data/ui";
import type { Category, Treatment } from "../../../../data/types";

export function getStaticPaths() {
  return getCategories("el").flatMap((category) =>
    category.treatments.map((treatment) => ({
      params: { category: category.slug, slug: treatment.slug },
      props: { locale: "el" as Locale, category, treatment },
    })),
  );
}

const { locale, category, treatment } = Astro.props as {
  locale: Locale;
  category: Category;
  treatment: Treatment;
};
const t = ui[locale];
const { prev, next } = getTreatmentNeighbours(locale, category.slug, treatment.slug);
const catHref =
  locale === "el"
    ? `/el/services/${category.slug}/`
    : `/services/${category.slug}/`;
const href = (slug: string) =>
  locale === "el"
    ? `/el/services/${category.slug}/${slug}/`
    : `/services/${category.slug}/${slug}/`;
const num = String(category.treatments.findIndex((x) => x.slug === treatment.slug) + 1).padStart(2, "0");
---

<Base title={`${treatment.pageTitle} — High Beauty Care`} description={treatment.tagline}>
  <article class="border-t border-zinc-200">
    <div class="mx-auto w-full max-w-7xl px-6 pb-16 pt-40 md:px-10 md:pb-20 md:pt-52">
      <a
        href={catHref}
        class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400 transition-colors hover:text-zinc-900"
      >
        ← {category.title}
      </a>

      <p class="mt-10 flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.35em] text-zinc-900">
        <span aria-hidden="true" class="h-px w-12 bg-zinc-900"></span>
        {num} — {t.treatment.eyebrow}
      </p>
      <h1 class="mt-6 max-w-4xl font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl md:text-7xl">
        {treatment.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-500">
        {treatment.tagline}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={contact.phoneHref}
          class="inline-block bg-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-50 transition-colors hover:bg-zinc-700"
        >
          {t.treatment.bookCta}
        </a>
        {treatment.duration && (
          <span class="inline-block border border-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em]">
            {t.treatment.duration}: {treatment.duration}
          </span>
        )}
      </div>
    </div>
  </article>

  <article class="border-t border-zinc-200">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-6 py-20 md:px-10 md:py-28 lg:grid-cols-3 lg:gap-16">
      <div class="lg:col-span-2">
        <p class="max-w-2xl text-lg leading-relaxed text-zinc-700">
          {treatment.description}
        </p>
      </div>

      <aside class="space-y-10 lg:order-first">
        {treatment.protocol && (
          <div class="border border-zinc-900 p-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              {t.treatment.protocol}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-zinc-700">{treatment.protocol}</p>
          </div>
        )}
        {treatment.note && (
          <div class="border border-zinc-900 p-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              {t.treatment.note}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-zinc-700">{treatment.note}</p>
          </div>
        )}
        {treatment.contra && (
          <div class="border border-zinc-200 p-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              {t.treatment.contra}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-zinc-500">{treatment.contra}</p>
          </div>
        )}
      </aside>
    </div>
  </article>

  {treatment.problems && (
    <section class="border-t border-zinc-200">
      <div class="mx-auto w-full max-w-7xl px-6 py-20 md:px-10 md:py-24">
        <h2 class="font-display text-3xl tracking-tight md:text-4xl">
          {t.treatment.problems}
        </h2>
        <ul class="mt-10 grid grid-cols-1 gap-x-10 sm:grid-cols-2">
          {treatment.problems.map((problem) => (
            <li class="flex items-start gap-4 border-t border-zinc-200 py-5 text-sm leading-relaxed text-zinc-700">
              <span aria-hidden="true" class="mt-[0.55rem] h-px w-6 shrink-0 bg-zinc-400"></span>
              {problem}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {treatment.benefits && (
    <section class="border-t border-zinc-200 bg-zinc-50">
      <div class="mx-auto w-full max-w-7xl px-6 py-20 md:px-10 md:py-24">
        <h2 class="font-display text-3xl tracking-tight md:text-4xl">
          {t.treatment.benefits}
        </h2>
        <ul class="mt-10 grid grid-cols-1 gap-x-10 sm:grid-cols-2">
          {treatment.benefits.map((benefit) => (
            <li class="flex items-start gap-4 border-t border-zinc-200 py-5 text-sm leading-relaxed text-zinc-700">
              <span aria-hidden="true" class="mt-[0.55rem] h-px w-6 shrink-0 bg-zinc-900"></span>
              {benefit}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {treatment.ingredients && (
    <section class="border-t border-zinc-200">
      <div class="mx-auto w-full max-w-7xl px-6 py-20 md:px-10 md:py-24">
        <h2 class="font-display text-3xl tracking-tight md:text-4xl">
          {t.treatment.ingredients}
        </h2>
        <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
          {treatment.ingredients.map((ingredient) => (
            <div class="border-t border-zinc-200 pt-6">
              <p class="font-display text-xl tracking-tight">{ingredient.name}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600">{ingredient.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <nav class="border-t border-zinc-200">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 divide-y divide-zinc-200 px-6 sm:grid-cols-2 sm:divide-x sm:divide-y-0 md:px-10">
      <div class="py-10 sm:pr-10">
        {prev ? (
          <a href={href(prev.slug)} class="group block">
            <span class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              ← {t.treatment.prev}
            </span>
            <span class="mt-2 block font-display text-xl tracking-tight transition-transform duration-300 group-hover:-translate-x-1 md:text-2xl">
              {prev.title}
            </span>
          </a>
        ) : (
          <a href={catHref} class="group block">
            <span class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              ← {t.treatment.backToCategory}
            </span>
            <span class="mt-2 block font-display text-xl tracking-tight transition-transform duration-300 group-hover:-translate-x-1 md:text-2xl">
              {category.title}
            </span>
          </a>
        )}
      </div>
      <div class="py-10 text-right sm:pl-10">
        {next ? (
          <a href={href(next.slug)} class="group block">
            <span class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              {t.treatment.next} →
            </span>
            <span class="mt-2 block font-display text-xl tracking-tight transition-transform duration-300 group-hover:translate-x-1 md:text-2xl">
              {next.title}
            </span>
          </a>
        ) : (
          <a href={catHref} class="group block">
            <span class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-400">
              {t.treatment.backToCategory} →
            </span>
            <span class="mt-2 block font-display text-xl tracking-tight transition-transform duration-300 group-hover:translate-x-1 md:text-2xl">
              {category.title}
            </span>
          </a>
        )}
      </div>
    </div>
  </nav>
</Base>
