---
import { ui } from "../data/ui";
import { contact } from "../data/contact";
import { getCategories, type Locale } from "../data/site";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = ui[locale];
const homeUrl = getRelativeLocaleUrl(locale, "/");
const categories = getCategories(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400">
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-3 md:px-10"
  >
    <div>
      <p class="font-display text-xl uppercase tracking-[0.2em] text-zinc-50">
        High Beauty Care
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed">{t.footer.tagline}</p>
    </div>

    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-500">
        {t.footer.services}
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          categories.map((category) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `/services/${category.slug}/`)}
                class="transition-colors hover:text-zinc-100"
              >
                {category.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-500">
        {t.nav.contact}
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={contact.phoneHref} class="transition-colors hover:text-zinc-100">
            {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a
            href={`mailto:${contact.email}`}
            class="transition-colors hover:text-zinc-100"
          >
            {contact.email}
          </a>
        </li>
        <li>{contact.street}, {contact.city}</li>
        <li>
          <a
            href={contact.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-zinc-100"
          >
            {contact.instagramHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-zinc-800">
    <div
      class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-2 px-6 py-6 text-[11px] uppercase tracking-[0.2em] md:px-10"
    >
      <p>© {year} High Beauty Care — {t.footer.rights}</p>
      <a href={homeUrl} class="transition-colors hover:text-zinc-100">
        High Beauty Care
      </a>
    </div>
  </div>
</footer>
