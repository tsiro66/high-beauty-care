---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui } from "../data/ui";
import { contact } from "../data/contact";
import type { Locale } from "../data/site";
import studio3 from "../assets/media/studio-3.jpg";

const locale: Locale = "en";
const t = ui[locale];
const bookingHref = contact.bookingUrl;
const signatureSlugs = [
  "face/japanese-head-spa",
  "body/lymphatic-body-massage",
  "massage/relaxing-massage",
];
const signature = t.ourSpace.signature.map((item, i) => ({
  ...item,
  href: getRelativeLocaleUrl(locale, `/services/${signatureSlugs[i]}/`),
}));
---

<Base title={`${t.ourSpace.eyebrow} — High Beauty Care`} description={t.ourSpace.heading}>
  <!-- Hero -->
  <section>
    <div class="mx-auto w-full max-w-7xl px-6 pb-16 pt-40 md:px-10 md:pb-20 md:pt-52">
      <p class="flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.35em] text-zinc-900">
        <span aria-hidden="true" class="h-px w-12 bg-zinc-900"></span>
        {t.ourSpace.eyebrow}
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
        {t.ourSpace.heading}
      </h1>
      <a
        href={bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-block bg-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-50 transition-colors hover:bg-zinc-700"
      >
        {t.ourSpace.cta}
      </a>
    </div>
  </section>

  <!-- Full-width studio image -->
  <section>
    <Image
      src={studio3}
      alt=""
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class="aspect-[16/9] max-h-[80vh] w-full object-cover"
      loading="eager"
    />
  </section>

  <!-- Premium space -->
  <section class="border-t border-zinc-200">
    <div class="mx-auto w-full max-w-7xl px-6 py-24 md:px-10 md:py-32">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl leading-tight tracking-tight sm:text-4xl">
          {t.ourSpace.premiumHeading}
        </h2>
        <p class="mt-6 text-base leading-relaxed text-zinc-600">
          {t.ourSpace.premium}
        </p>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-t border-zinc-200">
    <div class="mx-auto w-full max-w-7xl px-6 py-24 md:px-10 md:py-32">
      <h2 class="max-w-2xl font-display text-3xl leading-tight tracking-tight sm:text-4xl">
        {t.ourSpace.trustHeading}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-2">
        {t.ourSpace.trustItems.map((item) => (
          <div class="border-t border-zinc-200 pt-6">
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-900">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-600">
              {item.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Signature treatments -->
  <section class="border-t border-zinc-200">
    <div class="mx-auto w-full max-w-7xl px-6 py-24 md:px-10 md:py-32">
      <h2 class="max-w-2xl font-display text-3xl leading-tight tracking-tight sm:text-4xl">
        {t.ourSpace.treatmentsHeading}
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-600">
        {t.ourSpace.treatmentsSub}
      </p>

      <ol class="mt-12">
        {signature.map((item, i) => (
          <li class="border-t border-zinc-200 last:border-b">
            <a
              href={item.href}
              class="group flex flex-col gap-2 py-8 md:flex-row md:items-baseline md:gap-10"
            >
              <span class="font-sans text-[11px] tracking-[0.3em] text-zinc-400 transition-colors group-hover:text-zinc-900">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-display text-2xl leading-tight tracking-tight text-zinc-900 transition-transform duration-300 group-hover:translate-x-1 md:w-1/3 md:text-3xl">
                {item.title}
              </span>
              <span class="flex-1 text-sm leading-relaxed text-zinc-600 md:text-base">
                {item.text}
              </span>
              <span
                aria-hidden="true"
                class="hidden shrink-0 self-center font-sans text-lg text-zinc-400 transition-all duration-300 group-hover:translate-x-1 group-hover:text-zinc-900 md:block"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-zinc-950 text-zinc-50">
    <div class="mx-auto w-full max-w-7xl px-6 py-24 text-center md:px-10 md:py-32">
      <h2 class="mx-auto max-w-xl font-display text-3xl leading-tight tracking-tight sm:text-5xl">
        {t.ourSpace.ctaBandHeading}
      </h2>
      <a
        href={bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-block bg-ivory px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-900 transition-colors hover:bg-white"
      >
        {t.ourSpace.ctaBandCta}
      </a>
    </div>
  </section>
</Base>
