---
import type { Category } from "../data/types";
import { ui } from "../data/ui";
import type { Locale } from "../data/site";

interface Props {
  category: Category;
  index: number;
  locale: Locale;
}

const { category, index, locale } = Astro.props;
const t = ui[locale];
const href =
  locale === "el"
    ? `/el/services/${category.slug}/`
    : `/services/${category.slug}/`;
const num = String(index + 1).padStart(2, "0");
---

<a
  href={href}
  class="group relative flex min-h-[16rem] flex-col justify-between border border-zinc-900 p-8 transition-colors hover:bg-zinc-950 md:min-h-[18rem]"
>
  <span class="font-sans text-[11px] tracking-[0.3em] text-zinc-400 transition-colors group-hover:text-zinc-500">
    {num}
  </span>

  <span>
    <span class="block font-display text-2xl leading-tight tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-50 md:text-3xl">
      {category.title}
    </span>
    <span class="mt-3 block text-xs uppercase tracking-[0.2em] text-zinc-500 transition-colors group-hover:text-zinc-400">
      {t.category.treatmentsCount(category.treatments.length)}
    </span>
    <span class="mt-4 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-900 transition-colors group-hover:text-zinc-50">
      {t.home.discover}
      <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </span>
</a>
