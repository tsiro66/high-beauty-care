---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "High Beauty Care — Στούντιο Αισθητικής & Ευεξίας",
  description = "Περιποιήσεις προσώπου, ολιστικές θεραπείες προσώπου και σώματος και εξειδικευμένες αγωγές κατά της κυτταρίτιδας στη Νέα Ιωνία. Προσωπική φροντίδα, κορυφαία προϊόντα, αποτελέσματα με διάρκεια.",
} = Astro.props;
const lang = Astro.currentLocale ?? "el";
const skipText =
  lang === "el" ? "Μετάβαση στο περιεχόμενο" : "Skip to content";
const siteUrl = Astro.site ?? new URL("https://highbeautycare.gr");
const path = Astro.url.pathname;
const isEn = path.startsWith("/en");
const enPath = isEn ? path : `/en${path === "/" ? "" : path}`;
const elPath = isEn ? path.slice(3) || "/" : path;
const canonicalUrl = new URL(path, siteUrl);
const enUrl = new URL(enPath, siteUrl);
const elUrl = new URL(elPath, siteUrl);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="el" href={elUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={elUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="/og.jpg" />
    <meta property="og:locale" content={lang === "el" ? "el_GR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "el" ? "en_US" : "el_GR"} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-ivory text-zinc-900">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-xs focus:font-semibold focus:tracking-[0.2em] focus:text-zinc-50 focus:uppercase"
      >{skipText}</a
    >

    <Navbar />

    <main id="content" class="min-h-screen">
      <slot />
    </main>

    <Footer />

    <script>
      /* ClientRouter: if a navigation starts while the fullscreen menu is
         open, never leave the new page scroll-locked. */
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.style.overflow = "";
      });
    </script>
  </body>
</html>
