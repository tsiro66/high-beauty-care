---
import { ui } from "../data/ui";
import type { Locale } from "../data/site";
import heroVideo from "../assets/media/headspa-hero.mp4";
import heroPoster from "../assets/media/headspa-hero-poster.jpg";
import heroVerticalVideo from "../assets/media/headspa-hero-vertical.mp4";
import heroVerticalPoster from "../assets/media/headspa-hero-vertical-poster.jpg";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = ui[locale].home;
---

<section class="relative flex min-h-svh items-end overflow-hidden bg-stone-950">
  <!-- Portrait video: mobile only -->
  <video
    class="hero-video absolute inset-0 h-full w-full object-cover object-[50%_40%] md:hidden"
    src={heroVerticalVideo}
    poster={heroVerticalPoster.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
  </video>

  <!-- Landscape video: tablet/desktop -->
  <video
    class="hero-video absolute inset-0 hidden h-full w-full object-cover md:block"
    src={heroVideo}
    poster={heroPoster.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
  </video>

  <!-- Warm neutral wash: keeps skin tones, unifies the frame -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#f7f1e8]/15">
  </div>

  <!-- Scrim: seats the navbar, subtle warm falloff from the top -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-stone-950/50 via-stone-950/10 to-transparent"
  >
  </div>

  <!-- Scrim: readability behind the lower-left content, fading into the video -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-950/60 via-stone-950/20 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-stone-950/30 via-transparent to-transparent"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-36 pb-[calc(8.5rem+env(safe-area-inset-bottom))] md:px-10 md:pt-40 md:pb-[10.5rem]"
  >
    <div class="max-w-[540px]">
      <p
        class="flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.35em] text-zinc-100/80"
      >
        <span aria-hidden="true" class="h-px w-12 bg-zinc-100/70"></span>
        {t.eyebrow}
      </p>

      <h1
        class="mt-6 font-display text-4xl leading-[1.1] tracking-tight text-zinc-50 sm:text-5xl md:text-6xl"
      >
        {t.heading}
      </h1>

      <p class="mt-5 max-w-[440px] text-base leading-relaxed text-zinc-200 md:mt-6 md:text-lg">
        {t.sub}
      </p>

      <div class="mt-9 flex flex-col items-stretch gap-4 sm:flex-row sm:flex-wrap sm:items-center md:mt-10">
        <a
          href="#contact"
          class="inline-flex w-full items-center justify-center border border-zinc-50/20 bg-zinc-900 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-50 transition-colors hover:border-zinc-50/40 hover:bg-zinc-800 sm:w-auto"
        >
          {t.primaryCta}
        </a>
        <a
          href="#services"
          class="inline-flex w-full items-center justify-center border border-zinc-50/50 px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.25em] text-zinc-50 transition-colors hover:border-zinc-50 hover:bg-zinc-50/10 sm:w-auto"
        >
          {t.secondaryCta}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[calc(1.75rem+env(safe-area-inset-bottom))] left-1/2 z-10 hidden -translate-x-1/2 sm:block"
  >
    <span class="scroll-cue block h-12 w-px bg-zinc-50/40"></span>
  </div>
</section>

<style>
  /* Subtle scroll cue drift (motion-safe only) */
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: scroll-cue-drift 2.6s ease-in-out infinite;
    }

    @keyframes scroll-cue-drift {
      0%,
      100% {
        transform: scaleY(0.6);
        transform-origin: top;
        opacity: 0.5;
      }
      50% {
        transform: scaleY(1);
        transform-origin: top;
        opacity: 1;
      }
    }
  }

  /* Over the hero video the header reads ivory until the glass bar takes over.
     Scoped here so only pages with the hero are affected. */
  :global(#site-header:not(.is-scrolled):not(.is-open)) {
    color: var(--color-zinc-50);
  }

  :global(#site-header:not(.is-scrolled):not(.is-open) .book-cta) {
    background-color: transparent;
    border-color: rgb(250 250 250 / 0.4);
  }

  :global(#site-header:not(.is-scrolled):not(.is-open) .book-cta:hover) {
    background-color: rgb(250 250 250 / 0.12);
    border-color: rgb(250 250 250 / 0.7);
  }
</style>

<script>
  /* Kick playback if browser autoplay policy blocked the autoplay attribute */
  const videos = document.querySelectorAll<HTMLVideoElement>(".hero-video");
  videos.forEach((v) => v.play().catch(() => {}));

  const kick = () => {
    videos.forEach((v) => {
      if (v.paused) v.play().catch(() => {});
    });
  };
  window.addEventListener("pointerdown", kick, { once: true, passive: true });
  window.addEventListener("keydown", kick, { once: true });
</script>
